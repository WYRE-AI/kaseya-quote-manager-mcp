# Single-tenant credential (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load this. Do not add it to
# that service's environment or via env_file.
KASEYA_QUOTE_MANAGER_API_KEY=

# stdio (default) or http
MCP_TRANSPORT=stdio

# Bind address for HTTP. When unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image
# sets 0.0.0.0. The insecure-dev bypass ignores a non-loopback value and
# binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8080

# Required to start the HTTP transport, and at least 32 characters. The process
# logs an error and exits non-zero when this is empty, shorter than 32
# characters, or a known placeholder. Compose will not start when it is unset.
# Generate a value with: openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. This is refused unless NODE_ENV=development. The server
# logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1 even if
# MCP_HTTP_HOST is a wider address such as 0.0.0.0. A placeholder or short
# CONDUIT_S2S_SECRET still refuses to start.
# NODE_ENV=development
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP. Unset or empty means gateway. Only the exact
# values gateway and env are accepted; anything else (for example Gateway)
# refuses to start.
#   gateway: required x-kaseya-quote-manager-api-key header on each request;
#            KASEYA_QUOTE_MANAGER_API_KEY is never read.
#   env:     KASEYA_QUOTE_MANAGER_API_KEY from the process environment.
# The container image and the compose service set gateway. Stdio ignores this
# and reads KASEYA_QUOTE_MANAGER_API_KEY.
# AUTH_MODE=env

LOG_LEVEL=info
